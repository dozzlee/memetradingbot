# Helius (wallet monitoring via WebSocket)
HELIUS_API_KEY=

# Telegram (alerts channel — NOT the trading bot, just where filtered alerts get posted)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional cross-confirmation source
SOLANA_TRACKER_API_KEY=

# Comma-separated insider-cluster wallet addresses (from manual recon, see PRD §3)
TRACKED_WALLETS=

# --- Execution wallet (custodial — Vanguard holds this key and signs with it) ---
# Fernet key encrypting the bot's Solana private key at rest (vanguard_wallet.enc).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up somewhere OTHER than this server. If it's lost, the wallet's funds
# are unrecoverable. Never commit it, paste it in chat, or put it in logs.
WALLET_ENCRYPTION_KEY=

# Fixed position size per auto-trade, in USD.
POSITION_SIZE_USD=5

# Max USD deployed across open positions at once (caps concurrent auto-trades).
MAX_CAPITAL_DEPLOYED_USD=5

# Automatic exit rules, in percent move from entry.
TAKE_PROFIT_PCT=50
STOP_LOSS_PCT=20

# Jupiter swap slippage tolerance, in basis points (150 = 1.5%).
SLIPPAGE_BPS=150
